[node name="NPC_StupaCaretaker" parent="." unique_id=987711 instance=ExtResource("47_explornpc")]
position = Vector2(843, 331)
npc_name = "Stupa Caretaker"
sprite_texture = ExtResource("40_monk")
sprite_scale = Vector2(0.036, 0.036)
dialogue_lines = [{
"speaker": "Stupa Caretaker",
"text": "Yeh stupa keval pathar ki rachna nahi. Yeh yahan ke jeevan aur parampara ka ek mahatvapurn hissa hai."
}, {
"speaker": "Stupa Caretaker",
"text": "Yahan prarthana aur shanti ka vatavaran vidyarthiyon ko ekagratha pradan karta hai."
}]
quest_id = "stupa_caretaker"

[node name="NPC_ViharaWorker" parent="." unique_id=987712 instance=ExtResource("47_explornpc")]
position = Vector2(242, 160)
npc_name = "Vihara Worker"
sprite_texture = ExtResource("43_qsrvs")
sprite_scale = Vector2(0.036, 0.036)
dialogue_lines = [{
"speaker": "Vihara Worker",
"text": "Vihara mein rehne wale vidyarthiyon aur bhikshuson ke liye har din bahut saare kaam sambhalne padte hain."
}, {
"speaker": "Vihara Worker",
"text": "Nalanda ki yeh sundar eetain aur kothriyan sadiyon ki mehnat se bani hain."
}]
quest_id = "vihara_supplies"

[node name="NPC_SeniorStudent" parent="." unique_id=987713 instance=ExtResource("47_explornpc")]
position = Vector2(444, 368.8)
npc_name = "Senior Student"
sprite_texture = ExtResource("41_8td27")
sprite_scale = Vector2(0.036, 0.036)
dialogue_lines = [{
"speaker": "Senior Student",
"text": "Nalanda mein har din naye logon aur naye vicharon se milne ka mauka milta hai."
}, {
"speaker": "Senior Student",
"text": "Tarka aur samvad hi yahan ke shastra-arth ka mool aadhar hain."
}]
quest_id = "missing_student"

[node name="NPC_Scholar" parent="." unique_id=987714 instance=ExtResource("47_explornpc")]
position = Vector2(681.7, 280.5)
npc_name = "Scholar"
sprite_texture = ExtResource("42_qsrvs")
sprite_scale = Vector2(0.036, 0.036)
dialogue_lines = [{
"speaker": "Scholar",
"text": "Ek achha vidwan keval jo padhta hai usse yaad nahi rakhta. Woh us par prashn bhi karta hai."
}, {
"speaker": "Scholar",
"text": "Dharmaganja ke teeno bhawan gyan ka anant sagar hain."
}]
quest_id = "scholar_question"

[node name="NPC_YoungStudent" parent="." unique_id=987715 instance=ExtResource("47_explornpc")]
position = Vector2(734, 290)
