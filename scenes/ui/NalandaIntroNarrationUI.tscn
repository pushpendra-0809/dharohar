[node name="NarrationText" type="RichTextLabel" parent="MainPanel/MarginContainer/VBox/ContentBox/MarginContainer/VBox/ScrollContainer/TextMargin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.2, 0.12, 0.06, 1)
