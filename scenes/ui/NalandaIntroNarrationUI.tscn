theme_override_fonts/bold_font = ExtResource("6_oswald_bold")
theme_override_font_sizes/normal_font_size = 16
theme_override_font_sizes/bold_font_size = 16
bbcode_enabled = true
text = "More than a thousand years ago, in the ancient land of Bihar, stood one of the world's great centres of learning.\n\nThis place was known as Nalanda Mahavihara.\n\nNalanda was not simply a collection of buildings. It was a living community of students, teachers, scholars, monks, and travellers who came together in the pursuit of knowledge.\n\nStudents came to Nalanda from different regions, carrying with them different ideas, traditions, and experiences.\n\nHere, learning went far beyond a single subject.\n\nStudents studied subjects such as mathematics, astronomy, medicine, philosophy, and logic. They also discussed ideas, debated with one another, and learned from their teachers and fellow scholars.\n\nNalanda became famous far beyond the Indian subcontinent.\n\nOne of the most famous visitors was the Chinese scholar Xuanzang, who spent several years studying at Nalanda and later described his experiences there.\n\nDuring his time at Nalanda, the renowned teacher and abbot Shilabhadra was one of the scholars associated with his studies.\n\nThe life of Nalanda was built around learning, discussion, discipline, and community.\n\nStudents lived, studied, read manuscripts, attended teachings, discussed ideas, and helped maintain the university around them.\n\nEvery building had a purpose.\n\nThe Stupas were places of reflection and spiritual practice.\n\nThe Library preserved and housed knowledge.\n\nThe Viharas were places where students lived, studied, and shared their daily lives.\n\nAs you explore Nalanda, remember that you are not simply walking through an ancient site.\n\nYou are stepping into a world built around the pursuit of knowledge.\n\nLook carefully.\n\nTalk to the people you meet.\n\nObserve your surroundings.\n\nAnd most importantly, stay curious.\n\nYour journey through Nalanda begins now."
fit_content = true
scroll_active = false
autowrap_mode = 3

