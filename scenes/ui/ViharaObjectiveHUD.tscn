bbcode_enabled = true
fit_content = true
text = "[color=#f0d080][b]EXPERIENCE GOAL:[/b][/color]
Prepare Nalanda's residential monastery before the evening prayer & study bell rings. Complete all 4 community preparation tasks to unlock and ring the Evening Bell."
[node name="TasksLabel" type="RichTextLabel" parent="GuideModal/Panel/Margin/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("3_reg")
theme_override_font_sizes/normal_font_size = 12
bbcode_enabled = true
fit_content = true
text = "[color=#ffd700][b]TASKS & LOCATIONS:[/b][/color]

[color=#ffaa44]🪔 1. Light the Study Lamps[/color]
• Go to [b]Oil Lamps Depot[/b] (North-East) → Pick up brass oil lamp.
• Deliver to [b]Study Room Desk[/b] (East room) for Student Jinamitra.

[color=#ffaa44]📜 2. Deliver Astronomy Manuscript[/color]
• Go to [b]Senior Scribe Bodhiruchi[/b] (North terrace) → Pick up manuscript.
• Deliver to [b]Astronomy Scholar Varaha[/b] (North-West cell).

[color=#ffaa44]🏺 3. Arrange Water Vessels[/color]
• Go to [b]Water Depot[/b] (South-West) → Pick up fresh water vessels.
• Place on [b]Courtyard Water Stand[/b] (Center courtyard).

[color=#ffaa44]✍️ 4. Prepare Junior Study Space[/color]
• Go to [b]Writing Supplies Shelf[/b] (West corridor) → Pick up writing board & ink.
• Deliver to [b]Junior Student Desk[/b] (South-East room) for Student Soma.

[color=#ffdd44]🔔 5. Ring the Evening Bell (Sandhya Ghanta)[/color]
• Unlocks once all 4 tasks are complete!
• Ring the [b]Evening Bell[/b] (South courtyard near shrine) to finish the Vihara chapter.

[color=#88ff88][b]REWARDS:[/b][/color]
• 📜 Exactly 1 Vihara Scroll earned.
• 0 EXP awarded (EXP is reserved for NPC side quests)."
