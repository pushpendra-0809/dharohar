static func get_domain_data(domain_id: String) -> Dictionary:
	var key := domain_id.to_lower().strip_edges()
	if key == "math" or key == "mathematics" or key == "gaṇita" or key == "ganita":
		return DOMAINS["mathematics"]
	elif key == "astro" or key == "astronomy" or key == "jyotiṣa" or key == "jyotisha":
		return DOMAINS["astronomy"]
	elif key == "med" or key == "medicine" or key == "āyurveda" or key == "ayurveda":
		return DOMAINS["medicine"]
	elif key == "phil" or key == "philosophy" or key == "logic" or key == "darśana" or key == "darshana":
		return DOMAINS["philosophy"]
	return DOMAINS.get(key, {})

static func get_domain_title(domain_id: String) -> String:
	var d := get_domain_data(domain_id)
	return d.get("title", "NALANDA KNOWLEDGE GRANTH")

static func get_pages(domain_id: String) -> Array:
	var d := get_domain_data(domain_id)
	return d.get("pages", [])
